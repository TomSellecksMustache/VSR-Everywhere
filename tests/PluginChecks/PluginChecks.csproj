<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.1.0</JellyfinVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Jellyfin.Plugin.VsrEverywhere/Jellyfin.Plugin.VsrEverywhere.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- The real Jellyfin host supplies these; this standalone check needs them at runtime. -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" />
  </ItemGroup>
</Project>
