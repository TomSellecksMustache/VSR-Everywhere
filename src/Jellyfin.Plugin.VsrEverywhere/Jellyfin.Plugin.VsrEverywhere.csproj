<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Jellyfin.Plugin.VsrEverywhere</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.VsrEverywhere</RootNamespace>
    <Version>1.5.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Title>VSR Everywhere</Title>
    <Product>VSR Everywhere</Product>
    <Description>NVIDIA RTX Video Super Resolution and optional Auto HDR for Jellyfin, with HEVC streaming to Roku and compatible players.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.10.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="10.10.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="Configuration/configPage.html" />
    <EmbeddedResource Include="../../installer/downloads.lock.json" LogicalName="VsrEverywhere.Update.windows.json" />
    <EmbeddedResource Include="../../installer/linux/runtime.json" LogicalName="VsrEverywhere.Update.linux.json" />
    <EmbeddedResource Include="../../installer/linux/requirements.lock.txt" LogicalName="VsrEverywhere.Update.linux-requirements.txt" />
  </ItemGroup>
</Project>
